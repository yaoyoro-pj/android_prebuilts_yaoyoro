android_app_import {
    name: "Gramophone",
    apk: "gramophone/Gramophone.apk",
    presigned: true,
    product_specific: true,
    overrides: ["Music"],
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
}

android_app_import {
    name: "Viola",
    apk: "viola/Viola.apk",
    presigned: true,
    product_specific: true,
    overrides: [
        "Browser2",
        "CarHTMLViewer",
    ],
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
}
